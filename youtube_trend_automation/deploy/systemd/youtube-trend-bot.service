[Unit]
Description=YouTube Trend Automation Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/youtube-trend-automation
EnvironmentFile=/opt/youtube-trend-automation/.env
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/youtube-trend-automation/.venv/bin/python /opt/youtube-trend-automation/main.py --mode scheduler
Restart=always
RestartSec=10
StandardOutput=append:/opt/youtube-trend-automation/logs/systemd.log
StandardError=append:/opt/youtube-trend-automation/logs/systemd.log

[Install]
WantedBy=multi-user.target
